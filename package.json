{
  "name": "quest-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.12"
  },
  "workspaces": [
    "functions"
  ],
  "scripts": {
    "mock": "VITE_BACKEND=mock vite",
    "build:mock": "VITE_BACKEND=mock vite build",
    "dev": "concurrently --kill-others-on-fail -n fn,emu,web,tick,seed -c blue,magenta,green,yellow,cyan \"npm run build:watch -w functions\" \"npm run emulators\" \"vite\" \"node scripts/dev-tick.mjs\" \"node scripts/seed.mjs --wait || true\"",
    "players": "concurrently -n p2,p3,p4 -c cyan,red,white \"vite --port 5174 --strictPort\" \"vite --port 5175 --strictPort\" \"vite --port 5176 --strictPort\"",
    "emulators": "firebase emulators:start --only auth,firestore,storage,functions --project demo-quest-game --import ./.emulator-data --export-on-exit ./.emulator-data",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b && npm run typecheck -w functions",
    "test": "npm run build -w functions && firebase emulators:exec --only auth,firestore,storage --project demo-quest-game \"vitest run\"",
    "test:unit": "vitest run --project unit --project functions-memory",
    "seed": "node scripts/seed.mjs",
    "make-admin": "node scripts/make-admin.mjs",
    "import-schedule": "node scripts/packs/lancaster/import-schedule.mjs"
  },
  "dependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "firebase": "^13.0.0",
    "html-to-image": "^1.11.13",
    "leaflet": "^1.9.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-leaflet": "^5.0.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "firebase-tools": "^15.33.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
