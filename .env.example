# Festival Quest build-time configuration.
#
# LOCAL DEVELOPMENT NEEDS NONE OF THIS. `npm run dev` talks to the Firebase Emulator Suite
# (project id demo-festival-quest) with built-in defaults.
#
# These values are only needed for a production build that talks to the real Firebase project
# (see "Going live later" in README.md). Copy this file to `.env.local` (git-ignored) for a local
# production build; on GitHub, set the same names as repository secrets or variables
# (Settings > Secrets and variables > Actions) and .github/workflows/deploy.yml picks them up.
#
# Firebase web config is not confidential (it ships in the browser bundle); security comes from
# the Firestore/Storage rules and Auth, not from hiding these.

# Firebase console > Project settings > General > Your apps > Web app > SDK setup and configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" to make a production build (`npm run build`, `npm run preview`) talk to the local
# emulators instead of the real project. Leave unset or "false" for a real deploy.
VITE_USE_EMULATORS=false

# Optional, local only: point the dev app at emulators on non-default ports (e.g. to run a second
# copy of the stack next to `npm run dev`). Defaults match firebase.json.
# VITE_EMULATOR_HOST=127.0.0.1
# VITE_AUTH_EMULATOR_PORT=9099
# VITE_FIRESTORE_EMULATOR_PORT=8080
# VITE_STORAGE_EMULATOR_PORT=9199
# VITE_FUNCTIONS_EMULATOR_PORT=5001

# URL path the site is served from. GitHub Pages project sites live under /<repository-name>/,
# so this must start and end with a slash. The deploy workflow sets it for you; use "/" for
# a custom domain or a local preview.
VITE_BASE=/LancasterLunaticsMusicalMischief/
